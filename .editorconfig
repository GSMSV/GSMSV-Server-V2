root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official

[*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,css,scss,html}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[{*.go,go.mod,go.sum}]
indent_style = tab

[Makefile]
indent_style = tab
