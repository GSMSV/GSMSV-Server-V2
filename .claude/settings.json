{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "korean",
  "permissions": {
    "allow": [
      "Bash(./gradlew test *)",
      "Bash(./gradlew compileKotlin *)",
      "Bash(./gradlew compileTestKotlin *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(node --test .claude/hooks/test/*)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh * pr merge *)",
      "Bash(gh api *merge*)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh * pr merge *)",
      "PowerShell(gh api *merge*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-pr-merge.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-git-format.mjs\""
          }
        ]
      }
    ]
  }
}
